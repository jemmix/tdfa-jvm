---
import '../styles/global.css';
import { pages } from '../lib/pages';

interface Props {
    title: string;
    description?: string;
}
const { title, description = 'How tdfa-jvm compiles regular expressions to finite automata and JVM bytecode — explained for working engineers.' } = Astro.props;

const path = Astro.url.pathname;
const idx = pages.findIndex((p) => path.startsWith(p.href.replace(/\/$/, '')));
const prev = idx > 0 ? pages[idx - 1] : null;
const next = idx >= 0 && idx < pages.length - 1 ? pages[idx + 1] : null;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{`${title} — tdfa-jvm explained`}</title>
        <meta name="description" content={description} />
    </head>
    <body class="bg-zinc-100 text-zinc-900 antialiased">
        <div class="mx-auto flex max-w-7xl flex-col lg:flex-row">
            <aside class="lg:sticky lg:top-0 lg:h-screen lg:w-72 lg:shrink-0 lg:overflow-y-auto border-b border-zinc-200 bg-white lg:border-b-0 lg:border-r">
                <div class="px-6 py-6">
                    <a href="/" class="flex items-center gap-3">
                        <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
                            <rect width="32" height="32" rx="7" fill="#0f766e"></rect>
                            <circle cx="10" cy="16" r="3.2" fill="none" stroke="#fff" stroke-width="2"></circle>
                            <circle cx="23" cy="10" r="3.2" fill="none" stroke="#fff" stroke-width="2"></circle>
                            <circle cx="23" cy="22" r="3.2" fill="none" stroke="#fff" stroke-width="2"></circle>
                            <path d="M13 15l7-4M13 17l7 4" stroke="#fff" stroke-width="2"></path>
                            <circle cx="10" cy="16" r="0.9" fill="#fff"></circle>
                        </svg>
                        <span class="text-sm leading-tight font-semibold">
                            tdfa-jvm<br /><span class="font-normal text-zinc-500">explained</span>
                        </span>
                    </a>
                    <p class="mt-4 text-xs leading-relaxed text-zinc-500">
                        A stage-by-stage tour of a regex engine that compiles every pattern to a deterministic automaton and JVM bytecode, with no backtracking at match time.
                    </p>
                </div>
                <nav class="px-3 pb-8">
                    <ul class="space-y-0.5">
                        {
                            pages.map((p) => {
                                const active = path.startsWith(p.href.replace(/\/$/, ''));
                                return (
                                    <li>
                                        <a
                                            href={p.href}
                                            class:list={[
                                                'flex items-baseline gap-3 rounded-md px-3 py-1.5 text-sm',
                                                active ? 'bg-teal-50 font-semibold text-teal-900' : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900',
                                            ]}
                                        >
                                            <span class="font-mono text-xs text-zinc-400">{p.num}</span>
                                            <span>{p.short}</span>
                                        </a>
                                    </li>
                                );
                            })
                        }
                    </ul>
                    <div class="mt-6 rounded-md border border-zinc-200 bg-zinc-50 px-3 py-2 text-xs leading-relaxed text-zinc-500">
                        Source:
                        <a href="https://github.com/jemmix/tdfa-jvm" class="font-mono text-teal-700 hover:underline" target="_blank" rel="noopener">jemmix/tdfa-jvm</a>
                    </div>
                </nav>
            </aside>
            <main class="min-w-0 flex-1 bg-white">
                <article class="mx-auto max-w-3xl px-6 py-12 lg:px-12">
                    <slot />
                    <div class="mt-16 flex items-stretch justify-between gap-4 border-t border-zinc-200 pt-6">
                        {
                            prev ? (
                                <a href={prev.href} class="group min-w-0 flex-1">
                                    <div class="text-xs text-zinc-400">Previous</div>
                                    <div class="truncate text-sm font-medium text-teal-700 group-hover:underline">{prev.num}. {prev.title}</div>
                                </a>
                            ) : (
                                <span class="flex-1" />
                            )
                        }
                        {
                            next ? (
                                <a href={next.href} class="group min-w-0 flex-1 text-right">
                                    <div class="text-xs text-zinc-400">Next</div>
                                    <div class="truncate text-sm font-medium text-teal-700 group-hover:underline">{next.num}. {next.title}</div>
                                </a>
                            ) : (
                                <span class="flex-1" />
                            )
                        }
                    </div>
                </article>
            </main>
        </div>
    </body>
</html>
