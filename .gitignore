# Gradle
build/
.gradle/
.gradletasknamecache/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Profiling artifacts
*.hprof
hs_err_pid*
replay_pid*

# Logs
*.log

# sed -i backup droppings: BSD sed takes -i's backup suffix as an
# argument, so `sed -i -E` writes Foo.java-E (on macOS: sed -i '' -E).
# Gated by scripts/check-repo-hygiene.sh even if added by force.
*-E
*.class

# Generated by :prepareVendor (from vendor/*.tar.gz + patches/).
# Materialized under build/ which is already ignored above; this entry is
# belt-and-suspenders in case a sourceSet path ever points outside build/.
/build/generated/

# oracle build scratch and outputs (built from the committed pristine
# archive via build-*.sh — never committed)
vendor/re2j-oracle/.build/
vendor/re2j-oracle/*.jar
vendor/jdk-regex-jemmix/.build/
vendor/jdk-regex-jemmix/openjdk-regex-exact-restore/
