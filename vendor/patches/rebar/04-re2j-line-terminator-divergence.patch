# tdfa-jvm re2j vs java.util.regex line-terminator divergence.
#
# Our engine is a re2j drop-in replacement. re2j's line-terminator handling
# differs from java.util.regex in two ways:
#
# 1. `.` (without DOTALL): re2j excludes only \n; j.u.r also excludes \r,
#    U+0085, U+2028, U+2029. Our engine matches re2j (only \n excluded),
#    so `.` matches \r — count=1 where j.u.r reports 0.
#
# 2. `$` (without MULTILINE): re2j matches only at absolute end-of-input;
#    j.u.r also matches before a final line terminator. For "\n\n" re2j
#    finds 1 match, j.u.r finds 2. Our engine matches re2j — count=1.
#
# Patch: add java/hotspot entries with our (re2j-compatible) counts so the
# parity test resolves correctly under the java/hotspot identity.
--- benchmarks/definitions/test/dot.toml	2026-08-11 19:48:22
+++ benchmarks/definitions/test/dot.toml	2026-08-11 19:48:23
@@ -41,6 +41,7 @@
 regex = '.'
 haystack = "\r"
 count = [
+  { engine = 'java/hotspot', count = 1 },
   { engine = '^(d/dmd/std-regex|icu|java/hotspot|javascript/v8|regress)$', count = 0 },
   { engine = '.*', count = 1 },
 ]
--- benchmarks/definitions/test/func.toml	2026-08-11 19:48:22
+++ benchmarks/definitions/test/func.toml	2026-08-11 19:48:23
@@ -49,6 +49,7 @@
 regex = '$'
 haystack = "\n\n"
 count = [
+  { engine = 'java/hotspot', count = 1 },
   { engine = 'd/dmd/std-regex|go/regexp|re2|regress|rust/regex.*', count = 1 },
   { engine = '.*', count = 2 },
 ]
