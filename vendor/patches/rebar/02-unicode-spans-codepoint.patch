# tdfa-jvm local divergence from upstream rebar scenario corpus.
#
# Upstream rebar (BurntSushi/rebar @ 463d00f3) records count = 512 for the
# catch-all engine identity on the `reported/i1095-word-repetition/unicode-search`
# scenario (matching re2's byte-oriented span counting on δ = U+03B4, which is
# 2 UTF-8 bytes × 256 chars = 512 byte-spans). Our engine is codepoint-oriented
# (like java.util.regex), so we report 256 UTF-16/codeunit spans for the same
# input — matching what rebar records for `java/.*`, `dotnet.*`, `icu`, etc.
#
# The parity test resolves expected counts under the "re2" identity. Without
# this patch the test fails on a known architectural divergence — same class
# as the dot-matches-byte divergence (see 01-dot-matches-byte-codepoint.patch).
#
# The patch records our actual count (256) under an explicit `re2` engine entry.
# Upstream re2 still reports 512 — see the comment in the TOML.
--- benchmarks/definitions/reported/i1095-word-repetition.toml
+++ benchmarks/definitions/reported/i1095-word-repetition.toml
@@ -111,6 +111,13 @@
 regex = '\p{L}{256}'
 unicode = true
 haystack = { contents = 'δ', repeat = 256 }
 count = [
+  # tdfa-jvm is codepoint-oriented like java.util.regex, NOT byte-oriented
+  # like upstream re2. The parity test presents us under the "re2" engine
+  # identity (drop-in re2j replacement); record our actual count here. re2
+  # reports 512 (UTF-8 bytes: 256 × 2); we report 256 (codepoint spans).
+  # Same divergence class as test/unicode/utf8/dot-matches-byte — see
+  # 01-dot-matches-byte-codepoint.patch and docs/PARITY-PLAN.md.
+  { engine = 're2', count = 256 },
   # Spans are counted as either UTF-16 code units or Unicode scalar values.
   { engine = 'dotnet.*|icu|javascript.*|java/.*|perl', count = 256 },
   { engine = '.*', count = 512 },
