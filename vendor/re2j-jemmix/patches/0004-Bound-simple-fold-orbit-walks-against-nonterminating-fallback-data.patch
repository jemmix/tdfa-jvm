+package com.google.re2j;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+/**
+ * Tests that simple-fold orbit walks terminate.
+ *
+ * <p>Orbit walks (class-range folding, literal canonicalization, case-insensitive literal
+ * comparison) assume simpleFold's next-pointer graph cycles back to the walk's start. That holds
+ * for runes in CASE_ORBIT (generated as closed orbits) and for the toLower/toUpper fallback on
+ * symmetric pairs. It breaks for runes whose asymmetric case mappings postdate the table's Unicode
+ * version: U+1C80..U+1C88 (Cyrillic historic letters, Unicode 9.0; tables at 6.0) fall back into
+ * the partner's symmetric orbit, which never leads back -- compiling or matching such patterns used
+ * to hang forever. The walks are hop-bounded (Unicode.MAX_FOLD_ORBIT_HOPS), which degrades the
+ * nontermination to a terminating walk over the orbit the current data can express.
+ */
+@RunWith(JUnit4.class)
+public class CaseFoldTerminationTest {
+
+  private static Matcher matcher(String pattern, String input) {
+    return Pattern.compile(pattern).matcher(input);
+  }
+
+  @Test
+  public void foldWalkTerminatesOnHistoricCyrillicLiterals() {
+    // Every one of U+1C80..U+1C88 used to hang the compile under (?i).
+    for (char c = '\u1C80'; c <= '\u1C88'; c++) {
+      Pattern.compile("(?i)" + c);
+    }
+  }
+
+  @Test
+  public void foldWalkTerminatesOnHistoricCyrillicClasses() {
+    Pattern.compile("(?i)[\u1C80-\u1C88]");
+  }
+
+  @Test
+  public void boundedWalkCollectsTheExpressibleOrbit() {
+    // U+1C80 (Ꚁ) case-folds with В/в. The bounded walk must terminate and
+    // still fold: the orbit it can express contains the partner pair.
+    Matcher m = matcher("(?i)\u1C80", "\u0432");
+    assertTrue(m.find());
+    assertTrue(matcher("(?i)\u1C80", "\u0412").find());
+    assertTrue(matcher("(?i)\u1C80", "\u1C80").find());
+    assertFalse(matcher("(?i)\u1C80", "x").find());
+  }
+
+  @Test
+  public void matchTimeFoldComparisonTerminates() {
+    // equalsIgnoreCase walks the same orbit graph at match time.
+    assertTrue(matcher("(?i)\u0442", "\u0442").find());
+    assertFalse(matcher("(?i)\u0442", "x").find());
+  }
+}
