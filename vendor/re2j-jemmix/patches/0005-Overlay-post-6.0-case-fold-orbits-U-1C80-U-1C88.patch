diff --git a/java/com/google/re2j/UnicodeTables.java b/java/com/google/re2j/UnicodeTables.java
index 8bd827f..0d05f6e 100644
--- a/java/com/google/re2j/UnicodeTables.java
+++ b/java/com/google/re2j/UnicodeTables.java
@@ -4232,4 +4232,69 @@ final class UnicodeTables {
     map.put("Mn", foldMn);
     return map;
   }
+
+  // Case-fold orbit overlay: the asymmetric orbits the generated table
+  // predates. The Cyrillic historic letters U+1C80..U+1C88 (Unicode 9.0;
+  // the generated tables are 6.0) case-fold onto and with existing
+  // Cyrillic letters. Without these entries the simpleFold fallback walks
+  // into the partner's symmetric orbit: from a partner the walk misses the
+  // historic letter (stale folding), from the historic letter it never
+  // cycles back (nonterminating until 0004 bounded the walks). Entries are
+  // {rune, next} pairs sorted by rune; the next pointers close a single
+  // cycle over each orbit, exactly as the generated table does:
+  //   {В, в, Ꚁ} {Д, д, ꚁ} {О, о, Ꚃ} {С, с, ꚃ} {Т, т, Ꚅ, ꚅ}
+  //   {Ъ, ъ, Ꚇ} {Ѣ, ѣ, ꚇ} {Ԫ, ԫ, Ꚉ}
+  // Kept beside CASE_ORBIT rather than spliced into it: the array is
+  // char-indexed and A64A/A64B are beyond its length.
+  static final int[] CASE_ORBIT_OVERLAY = {
+      0x0412, 0x0432,
+      0x0414, 0x0434,
+      0x041E, 0x043E,
+      0x0421, 0x0441,
+      0x0422, 0x0442,
+      0x042A, 0x044A,
+      0x0432, 0x1C80,
+      0x0434, 0x1C81,
+      0x043E, 0x1C82,
+      0x0441, 0x1C83,
+      0x0442, 0x1C84,
+      0x044A, 0x1C86,
+      0x0462, 0x0463,
+      0x0463, 0x1C87,
+      0x1C80, 0x0412,
+      0x1C81, 0x0414,
+      0x1C82, 0x041E,
+      0x1C83, 0x0421,
+      0x1C84, 0x1C85,
+      0x1C85, 0x0422,
+      0x1C86, 0x042A,
+      0x1C87, 0x0462,
+      0x1C88, 0xA64A,
+      0xA64A, 0xA64B,
+      0xA64B, 0x1C88,
+  };
+
+  // foldOrbitOverlay returns the next rune in the overlay orbit containing
+  // r, or -1 when r is in none of them. Consulted by Unicode.simpleFold
+  // only after a CASE_ORBIT miss, so generated entries keep precedence.
+  // Binary search over the sorted pairs; allocation-free.
+  static int foldOrbitOverlay(int r) {
+    if (r < 0x0412 || r > 0xA64B) {
+      return -1;
+    }
+    int lo = 0;
+    int hi = CASE_ORBIT_OVERLAY.length / 2 - 1;
+    while (lo <= hi) {
+      int mid = (lo + hi) >>> 1;
+      int key = CASE_ORBIT_OVERLAY[2 * mid];
+      if (key < r) {
+        lo = mid + 1;
+      } else if (key > r) {
+        hi = mid - 1;
+      } else {
+        return CASE_ORBIT_OVERLAY[2 * mid + 1];
+      }
+    }
+    return -1;
+  }
 }
