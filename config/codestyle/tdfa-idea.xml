<?xml version="1.0" encoding="UTF-8"?>
<!-- tdfa code style — the single source of truth for project formatting.

     Import into IntelliJ IDEA: Settings > Editor > Code Style > Java >
     (gear) Import Scheme > IntelliJ IDEA code style XML > this file.
     Select the "tdfa" scheme. Reformatting (Ctrl+Alt+L) then produces
     code that passes the CI gates (spotless + checkstyle, wired in the
     root build.gradle from config/codestyle/).

     The machine formatter is the eclipse JDT profile in
     eclipse-formatter.properties (flat 4-space continuation indent, margin
     120, joins wraps that fit); checkstyle.xml enforces what formatters
     cannot rewrite. Change all artifacts together.

     Core rules:
       - no star imports (single-name imports only, on-demand threshold 999)
       - imports, not qualified names — except same-simple-name collisions
         (spotless shortenFullyQualifiedTypes mirrors this, skipping them)
       - import layout: others | blank | javax, java | blank | static
       - member order: static fields, static init, instance fields, instance
         init, constructors, methods, nested types last
       - mandatory braces for if/else/for/while/do-while bodies
       - 4-space indent AND flat 4-space continuation indent, margin 120,
         wraps that fit are joined
-->
<code_scheme name="tdfa">
  <option name="CLASS_COUNT_TO_USE_IMPORT_ON_DEMAND" value="999" />
  <option name="NAMES_COUNT_TO_USE_IMPORT_ON_DEMAND" value="999" />
  <option name="PACKAGES_TO_USE_IMPORT_ON_DEMAND">
    <value />
  </option>
  <JavaCodeStyleSettings>
    <option name="IMPORT_LAYOUT_TABLE">
      <value>
        <package name="" withSubpackages="true" static="false" />
        <emptyLine />
        <package name="javax" withSubpackages="true" static="false" />
        <package name="java" withSubpackages="true" static="false" />
        <emptyLine />
        <package name="" withSubpackages="true" static="true" />
      </value>
    </option>
  </JavaCodeStyleSettings>
  <codeStyleSettings language="JAVA">
    <option name="RIGHT_MARGIN" value="120" />
    <option name="KEEP_LINE_BREAKS" value="false" />
    <option name="KEEP_BLANK_LINES_IN_CODE" value="2" />
    <option name="KEEP_BLANK_LINES_BEFORE_RBRACE" value="2" />
    <option name="KEEP_CONTROL_STATEMENT_IN_ONE_LINE" value="false" />
    <option name="IF_BRACE_FORCE" value="3" />
    <option name="FOR_BRACE_FORCE" value="3" />
    <option name="WHILE_BRACE_FORCE" value="3" />
    <option name="DO_WHILE_BRACE_FORCE" value="3" />
    <indentOptions>
      <option name="INDENT_SIZE" value="4" />
      <option name="CONTINUATION_INDENT_SIZE" value="4" />
      <option name="TAB_SIZE" value="4" />
      <option name="USE_TAB_CHARACTER" value="false" />
    </indentOptions>
    <arrangement>
      <rules>
        <section>
          <rule>
            <match>
              <AND>
                <modifier>STATIC</modifier>
                <kind>FIELD</kind>
              </AND>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <AND>
                <modifier>STATIC</modifier>
                <kind>INIT_BLOCK</kind>
              </AND>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <kind>FIELD</kind>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <kind>INIT_BLOCK</kind>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <kind>CONSTRUCTOR</kind>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <kind>METHOD</kind>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <kind>CLASS</kind>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <kind>ENUM</kind>
            </match>
          </rule>
        </section>
        <section>
          <rule>
            <match>
              <kind>INTERFACE</kind>
            </match>
          </rule>
        </section>
      </rules>
    </arrangement>
  </codeStyleSettings>
</code_scheme>
