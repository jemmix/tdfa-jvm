<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions: findings that are deliberate, documented design
  decisions. The gate
  stays hard-fail for anything NOT listed here — new findings still break the
  build. Analyzer 4.10.5 (BCEL 6.13 + ASM 9.11 — classfile support
  beyond the current JDK); the 4.9.x/4.10.x detector waves flag the set
  below.

  Do not add entries without documenting the reason here.
-->
<FindBugsFilter>

    <!-- Tdfa's flat arrays + TdfaRunner's table fields
         are public API via RegexEngineFactory.create(Tdfa) — 29 live-array
         accessors freeze the internal representation; the (known, counted)
         exposure reports are excluded by design. The public construction
         entries (same exposure class) are the materializer's trusted path:
         the arrays are pipeline-owned and never mutated post-assembly. -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.dfa\.Tdfa$">
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.dfa\.TdfaRunner$">
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Shared builder vocabulary (Range/OpSeq/DfaStateBuilder) is public
         pipeline surface since the core package tree: determinize builds
         it, regopt rewrites Range.ops in place (BT22 §6.3), the
         materializer packs from it. The retained/mutated arrays are
         pipeline-owned by contract — same trusted-tier posture as Tdfa's
         construction entries above. -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.dfa\.(Range|OpSeq|DfaStateBuilder)$">
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- MatchResult's public ctor + register file is
         engine-API surface (reconstructFixed). -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.engine\.MatchResult$">
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- ProbeKey.equals is deliberately asymmetric (query side only) —
         documented HashMap-query contract. -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.determinize\.TdfaStateIndex\$ProbeKey$">
        <Bug pattern="EQ_UNUSUAL,EQ_CHECK_FOR_OPERAND_NOT_COMPATIBLE_WITH_THIS"/>
    </Match>

    <!-- ParseResult hands out its unmodifiable views of the named-group map
         (part of the frozen parser API); flagged only by the 4.9.8+ detector
         wave. -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.parser\.Parser$">
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- Builder null-check the compiler proves redundant; freeze-bound code,
         not worth churn. -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.tnfa\.Tnfa\$Builder$">
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!-- Deliberate: per-pattern child classloaders for generated code, no
         SecurityManager target (Java 8 floor module). -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.asm\.(TdfaAsmBackend|ShellEmitter|TdfaAsmBackend\$GenClassLoader)$">
        <Bug pattern="DP_CREATE_CLASSLOADER_INSIDE_DO_PRIVILEGED"/>
    </Match>

    <!-- Deliberate: catch-and-ignore on the emission-failure fallback paths
         (interpreter fallback is the documented behavior). -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.asm\.(TdfaAsmBackend|ShellEmitter)$">
        <Bug pattern="DE_MIGHT_IGNORE"/>
    </Match>

    <!-- PatternMatcher exposes its TDFAPattern (the shared machinery
         matcher surface is the frozen re2j-shaped API both facades
         serve); the ctor-stored pattern is pipeline-owned (effectively
         immutable — same trusted-tier posture as Tdfa's construction
         entries above). -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.compile\.PatternMatcher$">
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- JdkUnicodeDataProvider.tableFor hands its private static final
          Unicode tables (Any, Join_Control) to the compile pipeline —
          provider-owned and never mutated post-init: same trusted-tier
          posture as Tdfa's construction entries above. Flagged by the
          4.10.x detector wave (4.9.8 missed direct static-array
          returns). -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.unicode\.JdkUnicodeDataProvider$">
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- TDFAPattern's non-transient `engine`/`wholeEngine` fields
         (RegexEngine/WholeEngine, not Serializable): every TDFAPattern
         serialization is intercepted by the public writeReplace
         (inherited by the generated shells) and replaced by the
         SerialProxy BEFORE any field hits the wire — the pattern travels
         as facade Class + pattern + flags + provider identity and the
         proxy's recompile reconstitutes it. The fields can never reach
         a stream. (The `facade` field is a Class, itself serializable.) -->
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.compile\.TDFAPattern$">
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <Match classregex="^io\.github\.jemmix\.tdfa\.core\.compile\.TDFAPattern$">
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

</FindBugsFilter>
